# ───────────────────────── Python ─────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# ──────────────── Virtual env / package managers ───────────
.venv/
venv/
env/
.python-version
# uv: keep uv.lock tracked if you adopt it (reproducible env); ignore the cache
.uv/

# ───────────────────────── Caches ──────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.cache/

# ────────────────────── Editors / OS ───────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ────────────────── Docker build artifacts ─────────────────
docker-build.log

# ─────────── Model weights / checkpoints (NOT source) ───────
# Downloaded HF checkpoints and training outputs. These are large binaries.
# NOTE: small reference assets that ARE tracked on purpose live under
#   configs/**/(preprocessing|reference_data|scaling_factors), plus model
#   Jd.pt files — so do NOT add a blanket `*.pt` / `*.npz` rule here.
/checkpoints/
*.ckpt

# compile_dev gate baselines: untracked dev artifacts recorded against
# pre-refactor code (see compile_dev/README.md for how to regenerate).
# Scoped to compile_dev/ so the tracked Jd.pt / reference .pt assets above
# are unaffected.
compile_dev/*.pt

# ─────────────────── Training run outputs ──────────────────
/outputs/
/logs/
/results/
/runs/
wandb/
*.log

# ──────── Local datasets / large data artifacts ────────────
# Mount these at runtime; never commit them.
*.aselmdb
*.aselmdb-lock
*.lmdb
*.lmdb-lock
metadata*.npz

# Claude Code scratch output (redirect target for cluster-node ENOSPC workaround)
.claude_tmp_out.txt

# profiler traces (EQV3_PROF / ESEN_PROF output) — multi-GB, dev artifacts only
docs/train_speed_analysis/**/*.trace.json
docs/train_speed_analysis/**/*.png
